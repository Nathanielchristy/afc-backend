PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173
JWT_ISSUER=ecommerce-api
JWT_AUDIENCE=ecommerce-client

# Pine Labs Online Payments Configuration
PINELABS_MERCHANT_ID=your_pinelabs_merchant_id
PINELABS_CLIENT_ID=your_pinelabs_client_id
PINELABS_CLIENT_SECRET=your_pinelabs_client_secret
PINELABS_ENVIRONMENT=uat
PINELABS_WEBHOOK_SECRET=your_pinelabs_webhook_secret

# Admin Creation Defaults (Optional)
ADMIN_EMAIL=admin@afc.com
ADMIN_PASSWORD=your_admin_password
ADMIN_NAME=System Admin

# Kitchen Station Defaults (Optional)
KITCHEN_EMAIL=kitchen@afc.com
KITCHEN_PASSWORD=your_kitchen_password
KITCHEN_NAME=Kitchen Station

# OTP & Security
OTP_SECRET=your_otp_hmac_secret_key_here

# Email Provider Configuration (Brevo Transactional API / SMTP)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_API_BASE_PATH=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=noreply@afc.com
BREVO_SENDER_NAME="AFC - American Fried Chicken"

# Legacy SMTP Fallback (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="AFC - American Fried Chicken <noreply@afc.com>"
